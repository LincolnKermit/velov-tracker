# JCDecaux Developer API Key (VLS API)
# Get a key at https://developer.jcdecaux.com/
JCD_API_KEY=your_jcdecaux_api_key_here

# Firebase Admin SDK Configuration
# Option 1 (Recommended for Vercel / Cloud): Paste the full JSON string of your Firebase Service Account key
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "...", ...}

# Option 2 (Convenient for local / Raspberry Pi): Path to the serviceAccountKey.json file
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
